{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-library.local/schemas/funding-product.schema.json",
  "title": "Funding Product Schema",
  "description": "Schema for public-safe and internal funding product references used in AI Agent Library funding knowledge bases, partner resources, directories, and routing assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_name",
    "slug",
    "provider",
    "status",
    "visibility",
    "category",
    "funding_type",
    "borrower_profile",
    "requirements",
    "public_safe_language",
    "restricted_claims"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "description": "Human-readable funding product or product-family name.",
      "minLength": 2,
      "maxLength": 160
    },
    "slug": {
      "type": "string",
      "description": "URL-safe product slug.",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "provider": {
      "type": "object",
      "description": "Provider or partner reference.",
      "additionalProperties": false,
      "required": [
        "name",
        "relationship"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 160
        },
        "relationship": {
          "type": "string",
          "enum": [
            "direct",
            "affiliate",
            "referral",
            "broker",
            "marketplace",
            "white-label",
            "internal",
            "listed-resource",
            "unknown"
          ]
        },
        "public_name": {
          "type": "string",
          "description": "Public-safe provider name if different from internal name.",
          "maxLength": 160
        },
        "provider_url": {
          "type": "string",
          "format": "uri"
        },
        "disclosure": {
          "type": "string",
          "maxLength": 800
        }
      }
    },
    "status": {
      "type": "string",
      "description": "Current status of the product reference.",
      "enum": [
        "active",
        "draft",
        "in-review",
        "paused",
        "needs-refresh",
        "deprecated",
        "archived"
      ]
    },
    "visibility": {
      "type": "string",
      "description": "Whether this product detail can be public or must remain internal.",
      "enum": [
        "public",
        "public-safe",
        "internal",
        "private",
        "restricted"
      ],
      "default": "public-safe"
    },
    "category": {
      "type": "string",
      "description": "Broad product category.",
      "enum": [
        "Business",
        "Real Estate",
        "Personal",
        "Startup",
        "Ecommerce",
        "Equipment",
        "Marketplace",
        "Other"
      ]
    },
    "funding_type": {
      "type": "string",
      "description": "Primary funding type.",
      "enum": [
        "Term Loan",
        "Revenue Advance",
        "Revenue Based",
        "Business Line of Credit",
        "Revolving Line",
        "Installment Loan",
        "Asset Backed",
        "Equipment Finance",
        "Real Estate Capital",
        "Mortgage",
        "Hard Money",
        "Bridge",
        "Factoring",
        "Invoice Advance",
        "Credit Card",
        "Unsecured Line",
        "Equity",
        "Service",
        "Other"
      ]
    },
    "summary": {
      "type": "string",
      "description": "Public-safe product summary.",
      "maxLength": 1000
    },
    "borrower_profile": {
      "type": "object",
      "description": "Borrower or business profile this product may fit.",
      "additionalProperties": false,
      "required": [
        "best_for"
      ],
      "properties": {
        "best_for": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "not_best_for": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "business_stage": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "startup",
              "early-stage",
              "active-revenue",
              "established",
              "real-estate-investor",
              "ecommerce-seller",
              "equipment-buyer",
              "unknown"
            ]
          },
          "default": []
        },
        "credit_tiers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Excellent",
              "Good",
              "Fair",
              "Subprime",
              "No Credit Focus",
              "N/A",
              "Unknown"
            ]
          },
          "default": []
        }
      }
    },
    "requirements": {
      "type": "object",
      "description": "Common requirements, ranges, and documentation. These are not guarantees.",
      "additionalProperties": false,
      "required": [
        "documents"
      ],
      "properties": {
        "minimum_time_in_business_months": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_monthly_revenue": {
          "type": "number",
          "minimum": 0
        },
        "minimum_credit_score": {
          "type": "integer",
          "minimum": 300,
          "maximum": 850
        },
        "funding_amount_min": {
          "type": "number",
          "minimum": 0
        },
        "funding_amount_max": {
          "type": "number",
          "minimum": 0
        },
        "estimated_time_to_funding": {
          "type": "string",
          "maxLength": 120,
          "examples": [
            "24–48 Hours",
            "1–3 Days",
            "2–4 Weeks"
          ]
        },
        "documents": {
          "type": "array",
          "description": "Typical document requests.",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "common_disqualifiers": {
          "type": "array",
          "description": "Common caution or disqualification flags.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "notes": {
          "type": "string",
          "maxLength": 1500
        }
      }
    },
    "pricing_terms": {
      "type": "object",
      "description": "Public-safe pricing or term notes when approved for use.",
      "additionalProperties": false,
      "properties": {
        "term_range": {
          "type": "string",
          "maxLength": 160
        },
        "repayment_frequency": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "biweekly",
            "monthly",
            "draw-based",
            "on-sale",
            "on-payout",
            "varies",
            "unknown",
            "not-applicable"
          ]
        },
        "cost_description": {
          "type": "string",
          "maxLength": 600
        },
        "public_safe": {
          "type": "boolean",
          "description": "Whether these term notes are approved for public display.",
          "default": false
        }
      }
    },
    "routing": {
      "type": "object",
      "description": "Internal routing notes for agent workflows.",
      "additionalProperties": false,
      "properties": {
        "primary_product_family": {
          "type": "string",
          "enum": [
            "startup-credit-leverage",
            "revenue-advance-fast-capital",
            "business-line-revolving",
            "structured-growth-loan",
            "equipment-asset-finance",
            "real-estate-capital",
            "marketplace-ecommerce-capital",
            "other"
          ]
        },
        "intake_questions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "routing_notes": {
          "type": "string",
          "maxLength": 1500
        },
        "human_review_required": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "public_safe_language": {
      "type": "array",
      "description": "Approved language patterns for public descriptions.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "default": [
        "May be a fit",
        "Common requirements",
        "Potential options",
        "Funding readiness",
        "Provider review required"
      ]
    },
    "restricted_claims": {
      "type": "array",
      "description": "Claims this product reference must not make.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "default": [
        "Guaranteed approval",
        "Guaranteed funding",
        "Everyone qualifies",
        "Lowest rate guaranteed"
      ]
    },
    "disclaimers": {
      "type": "array",
      "description": "Required disclaimers for public use.",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "related_assets": {
      "type": "object",
      "description": "Related repo assets.",
      "additionalProperties": false,
      "properties": {
        "knowledge_base_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "example_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "site_pages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "schema_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date"
        },
        "last_reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "reviewed_by": {
          "type": "string",
          "maxLength": 140
        },
        "source": {
          "type": "string",
          "maxLength": 300
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
}
